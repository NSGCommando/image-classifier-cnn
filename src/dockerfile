# Alias the first stage results as 'builder'
FROM python:3.12.5-slim as builder
WORKDIR /build
# Copy requirements from root
COPY requirements_inference.txt .
# install the onnx-runtime-only site packages to our own location, denoted by '--user' flag
RUN pip install --user --no-cache-dir -r requirements_inference.txt

# Run Image
FROM python:3.12.5-slim
WORKDIR /img-classifier
# Copy first stage results via the 'builder' alias
COPY --from=builder /root/.local /root/.local

# Copy src code, includes scripts and saved model
COPY src/models/onnx_model.onnx ./src/models/onnx_model.onnx
copy src/schemas/data_strategies.py ./src/schemas/data_strategies.py
copy src/schemas/response_models.py ./src/schemas/response_models.py
COPY src/scripts/dispatcher.py ./src/scripts/dispatcher.py
COPY src/scripts/inference_worker.py ./src/scripts/inference_worker.py
COPY src/scripts/inference.py ./src/scripts/inference.py
copy src/scripts/cli.py ./src/scripts/cli.py
COPY src/utils/constants.py ./src/utils/constants.py
COPY src/utils/data_loader.py ./src/utils/data_loader.py
COPY src/utils/logging_config.py ./src/utils/logging_config.py
COPY src/utils/redis_client.py ./src/utils/redis_client.py
COPY src/utils/util_functions_inference.py ./src/utils/util_functions_inference.py
COPY src/run.py ./src/run.py
# Ensure pip knows where the site-packages are being installed
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/img-classifier
EXPOSE 8000
ENTRYPOINT ["python","-m", "src.run"]
CMD ["--server", "2"]